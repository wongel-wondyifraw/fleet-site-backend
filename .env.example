PORT=3001
NODE_ENV=development

# PostgreSQL connection
# Production / Render / Supabase:
# Prefer DATABASE_URL. The app uses it first when present and enables SSL.
# Use Supabase's transaction-mode pooler on port 6543 for the running app.
# Do not include quotes in Render's Environment value, and URL-encode special
# characters in the password if needed.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Local development fallback (used only when DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fleetsite

# Set to "true" to log every SQL statement to the console
DB_LOGGING=false

# JWT authentication
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Initial admin user (seeded on first boot when no users exist)
ADMIN_EMAIL=admin@fleetsite.local
ADMIN_PASSWORD=ChangeMe!123
